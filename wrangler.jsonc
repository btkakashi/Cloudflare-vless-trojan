{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-vless-trojan-hardened",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    }
  },
  "vars": {
    "PROXY_CONCURRENT_DIAL": "2",
    "CONNECT_TIMEOUT_MS": "1800",
    "FIRST_BYTE_TIMEOUT_MS": "3000",
    "ALLOW_PATH_PROXYIP": "false",
    "DEBUG": "false"
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [
        {
          "pattern": "btkakashi.cc.cd",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": ["17 */6 * * *"]
      },
      "kv_namespaces": [
        {
          "binding": "PROXY_POOL",
          "id": "16df6b9a71c94af786a514a1eb470046"
        }
      ],
      "vars": {
        "proxyip": "proxyip.hk.fxxk.dedyn.io,proxyip.jp.fxxk.dedyn.io",
        "PROXY_CONCURRENT_DIAL": "2",
        "CONNECT_TIMEOUT_MS": "1800",
        "FIRST_BYTE_TIMEOUT_MS": "3000",
        "ALLOW_PATH_PROXYIP": "false",
        "DEBUG": "false",
        "PROXY_DISCOVERY_HOSTS": "proxyip.hk.fxxk.dedyn.io,proxyip.jp.fxxk.dedyn.io",
        "PROXY_DISCOVERY_SAMPLE_SIZE": "24",
        "PROXY_POOL_SIZE": "6",
        "PROXY_PROBE_CONCURRENCY": "4",
        "PROXY_PROBE_TIMEOUT_MS": "1500",
        "PROXY_POOL_MAX_AGE_MS": "86400000"
      }
    }
  }
}
